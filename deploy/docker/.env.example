# Your server's domain (an A record pointing at the VM's public IP).
DOMAIN=voice.example.com
# Long random secret: root API key and one-time setup key for the first admin account.
#   openssl rand -base64 36
HTTP_GATEWAY_API_KEY=change-me
# Optional: everything below can also be set in the dashboard.
